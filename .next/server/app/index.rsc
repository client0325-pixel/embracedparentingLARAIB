ldren":"Connection before correction"}]]}]]}],["$","p",null,{"children":"Support is designed to strengthen security, trust, and belonging — especially when parenting has felt strained or overwhelming."}]]}],["$","div","Respect",{"className":"framework-card reveal","children":[["$","div",null,{"className":"framework-card-intro","children":[["$","div",null,{"className":"framework-card-mark","children":"R"}],["$","div",null,{"children":[["$","h3",null,{"children":"Respect"}],["$","div",null,{"className":"framework-card-subtitle","children":"Honoring each family story"}]]}]]}],["$","p",null,{"children":"Every family is met with care, curiosity, and respect — including cultural, faith, and lived-experience differences."}]]}],["$","div","Attunement",{"className":"framework-card reveal","children":[["$","div",null,{"className":"framework-card-intro","children":[["$","div",null,{"className":"framework-card-mark","children":"A"}],["$","div",null,{"children":[["$","h3",null,{"children":"Attunement"}],["$","div",null,{"className":"framework-card-subtitle","children":"Listening beneath the surface"}]]}]]}],["$","p",null,{"children":"We slow down and identify what a child may be communicating through their behavior, so responses become more intentional."}]]}],["$","div","Compassion",{"className":"framework-card reveal","children":[["$","div",null,{"className":"framework-card-intro","children":[["$","div",null,{"className":"framework-card-mark","children":"C"}],["$","div",null,{"children":[["$","h3",null,{"children":"Compassion"}],["$","div",null,{"className":"framework-card-subtitle","children":"Gentle, nonjudgmental support"}]]}]]}],["$","p",null,{"children":"The process is grounded in compassion for both the child and the parent, especially in moments of stress and doubt."}]]}],["$","div","Empowerment",{"className":"framework-card reveal","children":[["$","div",null,{"className":"framework-card-intro","children":[["$","div",null,{"className":"framework-card-mark","children":"E